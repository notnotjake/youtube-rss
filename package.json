{
	"name": "youtube-rss",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*",
		"#remotes": "./src/lib/remotes",
		"#remotes/*": "./src/lib/remotes/*",
		"#theme": "./src/lib/theme",
		"#theme/*": "./src/lib/theme/*",
		"#ui": "./src/lib/components",
		"#ui/*": "./src/lib/components/*",
		"#utils": "./src/lib/utils",
		"#utils/*": "./src/lib/utils/*"
	},
	"scripts": {
		"f": "bun scripts/fuzzy-bun-run.ts",
		"dev": "bun run docker:check && bunx --bun vite dev",
		"dev:emails": "email dev --dir src/lib/server/email",
		"update:env": "bun scripts/pull-env.ts",
		"railway:plan": "railway environment && railway config plan",
		"railway:apply": "railway environment && railway config apply",
		"docker:start": "docker compose up -d && bun run docker:check",
		"docker:stop": "docker compose stop",
		"docker:reset": "docker compose down -v",
		"docker:check": "bun scripts/check-docker.ts",
		"url:pg": "bun scripts/copy-docker-url.ts pg",
		"db:gen": "bunx --bun drizzle-kit generate",
		"db:migrate": "bunx --bun drizzle-kit migrate",
		"db:push": "bun run docker:check && bunx --bun drizzle-kit push",
		"db:studio": "bunx --bun drizzle-kit studio",
		"test": "bun test",
		"format": "bunx --bun oxfmt",
		"check": "bun scripts/check-all.ts",
		"check:lint": "eslint . --cache --concurrency auto",
		"check:format": "bunx --bun oxfmt --check .",
		"check:svelte": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:ts": "bunx --bun tsc --noEmit --project ./tsconfig.json",
		"preview": "bun run build && bunx --bun vite preview",
		"build": "bunx --bun vite build",
		"start": "bun run ./build",
		"prepare": "svelte-kit sync || echo ''"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/kit": "^3.0.0-next.23",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.3.14",
		"@types/node": "^26.2.0",
		"@types/react": "^19.2.18",
		"@typescript/native": "npm:typescript@^7.0.2",
		"drizzle-kit": "rc",
		"eslint": "^10.8.1",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"oxfmt": "^0.64.0",
		"railway": "^3.10.0",
		"svelte": "^5.56.9",
		"svelte-adapter-bun": "^1.0.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "npm:@typescript/typescript6@^6.0.3",
		"typescript-eslint": "^8.67.0",
		"vite": "^8.2.1"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@lucide/svelte": "^1.32.0",
		"@opensky/remotes": "^1.0.0",
		"@opensky/style": "^0.2.0",
		"@tabler/icons-svelte": "^3.46.0",
		"better-auth": "^1.7.1",
		"bits-ui": "^2.18.1",
		"croner": "^10.0.1",
		"drizzle-orm": "rc",
		"fast-xml-parser": "^5.11.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-email": "^6.9.2",
		"resend": "^6.20.0",
		"valibot": "^1.4.2"
	}
}
